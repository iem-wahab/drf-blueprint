# Django settings
DJANGO_SECRET_KEY=django-insecure-development-key-for-local-use-only
DJANGO_CONFIGURATION=Local

# Database settings (uncomment and configure for PostgreSQL if needed)
# DATABASE_URL=postgres://postgres:@localhost:5432/postgres
# POSTGRES_CONN_MAX_AGE=600

# AWS settings (for production only)
# DJANGO_AWS_ACCESS_KEY_ID=your-access-key
# DJANGO_AWS_SECRET_ACCESS_KEY=your-secret-key
# DJANGO_AWS_STORAGE_BUCKET_NAME=your-bucket-name

# Pagination
DJANGO_PAGINATION_LIMIT=10
